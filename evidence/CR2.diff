--- scripts.orig/backup_dir.sh	2026-10-21 15:25:11.000000000 +0900
+++ scripts/backup_dir.sh	2026-10-23 15:13:47.076480643 +0900
@@ -1,28 +1,56 @@
-#!/usr/bin/env bash
-# Usage: backup_dir.sh SOURCE_DIRECTORY DESTINATION_DIRECTORY
-set -u
-if (( $# != 2 )); then
-    echo 'Usage: backup_dir.sh SOURCE_DIRECTORY DESTINATION_DIRECTORY' >&2
+#!/bin/bash
+# ------------------------------------------------------------------
+# backup_dir.sh (CR-2 対応版)
+# 用途: 指定ディレクトリを tar.gz 形式でバックアップ保存する
+# 終了コード:
+#   0: 正常終了（アーカイブ生成成功）
+#   1: 異常終了（tar 圧縮処理自体の失敗）
+#   2: 取得・実行前失敗（引数不足、対象不在、保存先書込不可）
+# ------------------------------------------------------------------
+
+TARGET_DIR="$1"
+DEST_DIR="$2"
+
+# 1. 引数チェック
+if [ -z "$TARGET_DIR" ] || [ -z "$DEST_DIR" ]; then
+    echo "[ERROR] 使用方法: $0 <バックアップ対象ディレクトリ> <保存先ディレクトリ>" >&2
     exit 2
 fi
-source_dir=$(realpath -e -- "$1") || exit 2
-[[ -d "$source_dir" ]] || { echo 'Source is not a directory' >&2; exit 2; }
-dest_req=$(realpath -m -- "$2") || exit 2
-case "$dest_req/" in
-    "$source_dir/"*) echo 'Destination must be outside source' >&2; exit 2 ;;
-esac
-mkdir -p -- "$2" || exit 2
-dest_dir=$(realpath -e -- "$2") || exit 2
-archive="$dest_dir/backup-$(date +%Y%m%d-%H%M%S)-$$.tar.gz"
-partial="$archive.partial"
-trap 'rm -f -- "$partial"' EXIT
-if ! tar -czf "$partial" -C "$source_dir" .; then
-    echo 'NG reason=archive_failed' >&2
-    exit 1
+
+# 2. 対象ディレクトリの存在確認
+if [ ! -d "$TARGET_DIR" ]; then
+    echo "[FAIL] 対象ディレクトリが存在しません: $TARGET_DIR" >&2
+    exit 2
+fi
+
+# 3. 保存先ディレクトリの作成と書込権限チェック
+if [ ! -d "$DEST_DIR" ]; then
+    mkdir -p "$DEST_DIR" 2>/dev/null
+    if [ $? -ne 0 ]; then
+        echo "[FAIL] 保存先ディレクトリを作成できません: $DEST_DIR" >&2
+        exit 2
+    fi
+fi
+
+# 保存先への書き込み権限テスト
+if [ ! -w "$DEST_DIR" ]; then
+    echo "[FAIL] 保存先ディレクトリへの書き込み権限がありません: $DEST_DIR" >&2
+    exit 2
 fi
-if ! tar -tzf "$partial" >/dev/null; then
-    echo 'NG reason=archive_validation_failed' >&2
+
+# 4. アーカイブ作成
+TIMESTAMP=$(date +%Y%m%d_%H%M%S)
+TARGET_BASE=$(basename "$TARGET_DIR")
+ARCHIVE_NAME="${TARGET_BASE}_backup_${TIMESTAMP}.tar.gz"
+DEST_FILE="${DEST_DIR}/${ARCHIVE_NAME}"
+
+tar -czf "$DEST_FILE" -C "$(dirname "$TARGET_DIR")" "$TARGET_BASE" 2>/dev/null
+TAR_EXIT=$?
+
+if [ $TAR_EXIT -ne 0 ]; then
+    echo "[WARN] tar アーカイブ作成に失敗しました (終了コード: $TAR_EXIT)" >&2
     exit 1
 fi
-mv -- "$partial" "$archive" || exit 1
-printf '%s OK archive=%s\n' "$(date -Iseconds)" "$archive"
+
+echo "[OK] バックアップ正常完了: $DEST_FILE"
+exit 0
